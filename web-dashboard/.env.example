# ==============================================================================
# K-Apply SaaS Platform - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# MongoDB Configuration (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/kapply
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/kapply?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kapply
MONGODB_DB=kapply

# Ollama AI Engine (Local or Cloud-Hosted Ollama instance)
# Local Ollama: http://localhost:11434
# Hosted / Gateway: https://ollama.your-domain.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=

# Standalone Container Build (set to 'true' for Dockerfile builds)
BUILD_STANDALONE=false
